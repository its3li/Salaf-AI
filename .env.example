# Copy to .env.local for `npm run dev` (it runs the API locally), and set the same names in
# Vercel → Project → Settings → Environment Variables for Production and Preview.

# --- Current provider (server-side only) ---------------------------------------
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://your-provider.example/v1beta
GEMINI_MODEL=gemini-4-hydrogen
CHAT_EFFORT=low
DAILY_CREDIT_LIMIT=20
IP_DAILY_CREDIT_LIMIT=100
CHAT_RATE_LIMIT_MAX=3
CHAT_RATE_LIMIT_WINDOW_MS=60000
MEDIA_DAILY_SECONDS=1200
# Image policy is fixed in source: 3/message, 11/day, 2 credits/image plus 1/message.
# The URL is the native Gemini API base (can be the root URL for a compatible gateway).
# Local dev accepts BENCHMARK_* as aliases until you configure GEMINI_*.
# Production never uses benchmark credentials. Never use a VITE_ prefix for secrets.
# GEMINI_TIMEOUT_MS=600000        # local testing; production is capped below Vercel's 300s limit

# --- Retired provider / manual rollback only -----------------------------------
# CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://claude.c00l.site/v1
# CHAT_MODEL=claude-opus-5-5
# TITLE_MODEL=claude-sonnet-5-5

# --- Local benchmark only (not used by the app; never prefix secrets with VITE_) ---
# Add these to .env.local to test your own paid Gemini provider instead of OpenCode credentials.
# Both key and URL are required together. Google mode needs the native Gemini generateContent API,
# NOT an OpenAI-compatible /v1/chat/completions endpoint. Do not include /models/... in this URL.
# BENCHMARK_API_KEY=
# BENCHMARK_BASE_URL=https://your-provider.example/v1beta
# BENCHMARK_MODEL=gemini-4-hydrogen
# Probe only: node scripts/benchmark-messages.mjs --provider=google --probe

# --- Research tools (hadith checks need no key; these enable web search and page reading) ---
AQUADEVS_API_KEY=
PAXSENIX_API_KEY=

# --- Direct audio/video/PDF attachments ----------------------------------------
MEDIA_SIGNING_SECRET=             # long random string; changing it invalidates transcripts in saved chats
# BLOB_READ_WRITE_TOKEN=          # files over 2 MB; native limit 12 MB. Redis required on Vercel.
# Optional automatic speech fallback when native audio/video is explicitly rejected.
# Also used by the retired Anthropic workflow. Native success does not call these services.
# ASSEMBLYAI_API_KEY=
# POLLINATIONS_API_KEY=

# --- Optional: answer quality / length ---------------------------------------
# CHAT_EFFORT=low                 # Gemini: low | medium | high | xhigh. Low is the default.
# CHAT_MAX_TOKENS=16000

# --- Optional: usage limits ---------------------------------------------------
# DAILY_CREDIT_LIMIT=20           # approved credits per browser/day: text = 1, plus audio/video credits
# IP_DAILY_CREDIT_LIMIT=100       # approved shared-IP ceiling; incognito does not reset it
# MEDIA_DAILY_SECONDS=1200        # strict combined 20 minutes of audio/video per browser/day
# MEDIA_IP_DAILY_SECONDS=10800    # audio/video per network per day
# MEDIA_SITE_DAILY_SECONDS=36000  # audio/video for the whole site per day (caps transcription spend)
# MEDIA_MAX_SECONDS=10800         # longest single audio/video
# CHAT_RATE_LIMIT_MAX=3           # approved questions per minute per public IP
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_MAX_MESSAGES=20            # history messages accepted per request

# Shared counters so limits hold across all Vercel instances. Vercel's Upstash Redis
# integration adds these automatically; UPSTASH_REDIS_REST_URL / _TOKEN also work.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Daily usage report (Vercel Cron → Discord) --------------------------------
# CRON_SECRET=                    # long random string; Vercel signs its cron requests with it
# STATS_WEBHOOK_URL=              # Discord webhook for the report; defaults to FEEDBACK_WEBHOOK_URL

# --- Optional: other ----------------------------------------------------------
# SALAF_ALLOWED_ORIGINS=https://salaf-ai.vercel.app   # comma-separated, for cross-origin callers
# FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...   # receives "inaccurate answer" reports
