# Copy to .env.local for `npm run dev` (it runs the API locally), and set the same names in
# Vercel → Project → Settings → Environment Variables for Production and Preview.

# --- Required -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://claude.c00l.site/v1
CHAT_MODEL=claude-opus-5-5
# Names each new conversation after its first answer (same key and base URL).
TITLE_MODEL=claude-sonnet-5-5

# --- Research tools (hadith checks need no key; these enable web search and page reading) ---
AQUADEVS_API_KEY=
PAXSENIX_API_KEY=

# --- YouTube links and audio/video files (all needed, plus Redis and a Blob store on Vercel) ---
ASSEMBLYAI_API_KEY=
POLLINATIONS_API_KEY=             # the backup transcriber (Microsoft MAI Transcribe 2)
MEDIA_SIGNING_SECRET=             # long random string; changing it invalidates transcripts in saved chats
# BLOB_READ_WRITE_TOKEN=          # added by connecting a Vercel Blob store; needed for uploads

# --- Optional: answer quality / length ---------------------------------------
# CHAT_EFFORT=medium              # low | medium | high | xhigh | max
# CHAT_MAX_TOKENS=16000

# --- Optional: usage limits ---------------------------------------------------
# DAILY_CREDIT_LIMIT=50           # credits per user per day: 1 per message, 10 per hour of audio/video (0 = off)
# IP_DAILY_CREDIT_LIMIT=500       # ceiling per network so clearing browser data can't bypass the limit
# MEDIA_DAILY_SECONDS=3600        # audio/video per user per day
# MEDIA_IP_DAILY_SECONDS=10800    # audio/video per network per day
# MEDIA_SITE_DAILY_SECONDS=36000  # audio/video for the whole site per day (caps transcription spend)
# MEDIA_MAX_SECONDS=10800         # longest single audio/video
# CHAT_RATE_LIMIT_MAX=10          # questions per minute per network
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_MAX_MESSAGES=20            # history messages accepted per request

# Shared counters so limits hold across all Vercel instances. Vercel's Upstash Redis
# integration adds these automatically; UPSTASH_REDIS_REST_URL / _TOKEN also work.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Daily usage report (Vercel Cron → Discord) --------------------------------
# CRON_SECRET=                    # long random string; Vercel signs its cron requests with it
# STATS_WEBHOOK_URL=              # Discord webhook for the report; defaults to FEEDBACK_WEBHOOK_URL

# --- Optional: other ----------------------------------------------------------
# SALAF_ALLOWED_ORIGINS=https://salaf-ai.vercel.app   # comma-separated, for cross-origin callers
# FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...   # receives "inaccurate answer" reports
