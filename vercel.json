{
  "functions": {
    "api/chat.ts": { "maxDuration": 300, "supportsCancellation": true },
    "api/media.ts": { "maxDuration": 300 },
    "api/blogadmin.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/stats", "schedule": "10 0 * * *" },
    { "path": "/api/blogadmin?task=daily", "schedule": "0 6 * * *" }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/sitemap.xml", "destination": "/api/blogpage?sitemap=1" },
    {
      "source": "/blog",
      "destination": "/api/blogpage?lang=ar",
      "missing": [{ "type": "query", "key": "app" }]
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blogpage?lang=ar&slug=:slug",
      "missing": [{ "type": "query", "key": "app" }]
    },
    {
      "source": "/:lang(en|ur|fa)/blog",
      "destination": "/api/blogpage?lang=:lang",
      "missing": [{ "type": "query", "key": "app" }]
    },
    {
      "source": "/:lang(en|ur|fa)/blog/:slug",
      "destination": "/api/blogpage?lang=:lang&slug=:slug",
      "missing": [{ "type": "query", "key": "app" }]
    },
    {
      "source": "/s/:id",
      "destination": "/api/share?id=:id&page=1",
      "missing": [{ "type": "query", "key": "app" }]
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
